rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 내 학습 기록: 본인만 읽고 쓰기
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 주간 리그(참여를 켠 사람만): 로그인한 사람은 읽기, 쓰기는 본인 것만
    match /leagues/{week}/members/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && request.resource.data.xp is number && request.resource.data.xp >= 0 && request.resource.data.xp < 100000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 친구 코드: 만든 사람만 수정, 코드 6자리
    match /codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && code.size() == 6;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 응원: 정해진 문구만, 한 사람에게 하루 한 번(문서 ID로 막아요)
    match /cheers/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to + '_' + request.resource.data.day
        && request.resource.data.sticker in ['화이팅!', '대단해요', '같이 해요', '오늘도 힘내요', '고마워요'];
      allow read: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // 신고: 쓰기만 가능(읽기는 콘솔에서만)
    match /reports/{id} {
      allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
    }
  }
}
