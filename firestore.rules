rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 개발자: admins/{내 uid} 문서가 있는 계정(콘솔에서만 만들 수 있어요)
    function isDev() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
    // 공지: 누구나 읽고, 개발자만 씀
    match /config/{doc} {
      allow read: if true;
      allow write: if isDev();
    }

    // 이메일 인증을 마친 계정만 커뮤니티 기능(리그·친구·응원·대화)을 써요
    function verified() { return request.auth.token.email_verified == true; }

    // 내 학습 기록: 본인만 읽고 쓰기
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 주간 리그(참여를 켠 사람만): 로그인한 사람은 읽기, 쓰기는 본인 것만
    match /leagues/{week}/members/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && verified() && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && request.resource.data.xp is number && request.resource.data.xp >= 0 && request.resource.data.xp < 100000
        && (!('title' in request.resource.data) || request.resource.data.title in ['', '새싹 참새', '날갯짓 참새', '하늘 참새', '한 달 참새', '전설의 참새', 'JLPT 정복자']);
      allow delete: if request.auth != null && (request.auth.uid == uid || isDev());
    }

    // 친구 코드: 만든 사람만 수정, 코드 6자리
    match /codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && verified() && request.resource.data.uid == request.auth.uid && code.size() == 6;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 응원: 정해진 이모티콘만(예전 문구도 허용), 한 사람에게 하루 한 번(문서 ID로 막아요)
    match /cheers/{id} {
      allow create: if request.auth != null && verified() && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to + '_' + request.resource.data.day
        && request.resource.data.sticker in ['👍', '🔥', '💪', '🎉', '👏', '🌸', '😊', '⭐', '🐥', '💖', '화이팅!', '대단해요', '같이 해요', '오늘도 힘내요', '고마워요'];
      allow read: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // 친구 추가 기록(한 방향). 서로 추가돼 있어야 맞친구
    match /follows/{id} {
      allow get: if request.auth != null && (id.matches(request.auth.uid + '_.*') || id.matches('.*_' + request.auth.uid));
      allow create: if request.auth != null && verified() && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to;
      allow delete: if request.auth != null && id.matches(request.auth.uid + '_.*');
    }

    // 1:1 대화: 맞친구끼리만 읽고 쓰기
    function inPair(pair) { return request.auth.uid in pair.split('_'); }
    function isMutual(pair) {
      return exists(/databases/$(database)/documents/follows/$(pair.split('_')[0] + '_' + pair.split('_')[1]))
          && exists(/databases/$(database)/documents/follows/$(pair.split('_')[1] + '_' + pair.split('_')[0]));
    }
    match /chats/{pair}/msgs/{mid} {
      allow read: if request.auth != null && inPair(pair) && isMutual(pair);
      allow create: if request.auth != null && verified() && inPair(pair) && isMutual(pair)
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200;
    }

    // 선물(씨앗·아이템): 서로 친구인 사람에게만, 한 사람에게 하루 한 번(문서 ID로 막아요). 받는 사람만 '받음'으로 바꿀 수 있어요
    match /gifts/{id} {
      allow create: if request.auth != null && verified() && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to + '_' + request.resource.data.day
        && request.resource.data.claimed == false
        && isMutual(request.auth.uid + '_' + request.resource.data.to)
        && ((request.resource.data.kind == 'seed' && request.resource.data.amount is int && request.resource.data.amount >= 1 && request.resource.data.amount <= 200)
         || (request.resource.data.kind == 'item' && request.resource.data.item is string && request.resource.data.item.size() <= 30));
      allow read: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow update: if request.auth != null && resource.data.to == request.auth.uid && resource.data.claimed == false
        && request.resource.data.claimed == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);
    }

    // 신고: 쓰기만 가능(읽기는 콘솔에서만)
    match /reports/{id} {
      allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
      allow read, delete: if isDev();
    }
  }
}
