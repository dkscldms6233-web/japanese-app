{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "**/.*", "!.well-known/**", "**/node_modules/**",
      "tools/**", "store/**", "notes-organizer/**", "*.py", "*.md", "firestore.rules"
    ],
    "cleanUrls": false,
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }] }
    ]
  }
}
