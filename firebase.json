{
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "hosting": [
    {
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "!.well-known/**",
        "**/node_modules/**",
        "tools/**",
        "store/**",
        "notes-organizer/**",
        "functions/**",
        "*.py",
        "*.md",
        "firestore.rules",
        "studio-site/**"
      ],
      "cleanUrls": false,
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
            }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      ],
      "target": "app"
    },
    {
      "target": "studio",
      "public": "studio-site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": false
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}